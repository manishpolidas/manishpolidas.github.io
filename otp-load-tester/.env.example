# ---------------------------------------------------------------------------
# OTP Testing & Load-Testing Platform - example environment file
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Dashboard authentication ------------------------------------------------
# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-dev-only-secret-change-me-dev-only
SESSION_TTL_SECONDS=3600

# Single-user setup. Generate the hash with: npm run hash-password -- 'mypassword'
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
# Development-only convenience. Ignored when NODE_ENV=production.
DASHBOARD_PASSWORD=admin123

# Optional multi-user setup (overrides the single-user variables above).
# JSON array: [{"username":"admin","passwordHash":"scrypt$...","role":"admin"}]
# Roles: admin (create/run/delete tests), viewer (read-only).
DASHBOARD_USERS_JSON=

# --- Pepper used to hash generated OTPs before storage -----------------------
OTP_HASH_PEPPER=change-me-otp-pepper

# --- SMS provider mode -------------------------------------------------------
# mock       -> local simulator, no network calls (DEFAULT, always safe)
# sandbox    -> vendor sandbox/test endpoint that never delivers to real phones
# authorized -> real delivery; only for recipients you own and have authorized
SMS_MODE=mock

# Mock provider behaviour
MOCK_LATENCY_MS=120
MOCK_LATENCY_JITTER_MS=80
MOCK_FAILURE_RATE=0.05

# Sandbox provider (only read when SMS_MODE=sandbox)
SANDBOX_API_URL=
SANDBOX_API_KEY=
SANDBOX_TIMEOUT_MS=8000

# Authorized provider (only read when SMS_MODE=authorized)
AUTHORIZED_API_URL=
AUTHORIZED_API_KEY=
# Required for sandbox/authorized modes: recipients that may be targeted.
RECIPIENT_ALLOWLIST=

# --- Safety limits (hard caps are enforced in code and cannot be raised) -----
MAX_MESSAGES_PER_MINUTE=60
MAX_MESSAGES_PER_TEST=500
MAX_DURATION_SECONDS=900
MAX_CONCURRENT_TESTS=3
# API request rate limit (per session/IP)
API_RATE_LIMIT_PER_MINUTE=120

# Keep plaintext OTPs in the activity log. Forced off outside mock mode.
STORE_PLAINTEXT_OTP=true

# --- Persistence -------------------------------------------------------------
# memory   -> zero-setup, data lost on restart (DEFAULT)
# postgres -> requires DATABASE_URL and db/schema.sql applied
PERSISTENCE=memory
DATABASE_URL=postgres://otp:otp@localhost:5432/otp_testing
